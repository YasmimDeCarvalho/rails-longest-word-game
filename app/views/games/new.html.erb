<h1>Longest Word Game</h1>

  <ul class="list-group list-group-horizontal gap-1">
    <% @letters.each do |letter| %>
      <li class="list-group-item bg-primary text-white rounded-3"><%= letter %></li>
    <% end %>
  </ul>

<div class="container p-2">
  <form action="/score" method="post" data-turbo="false">
    <input type="text" name="word" class="form-control w-50" placeholder="Your word">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <%= hidden_field_tag :letters, @letters.join(",") %>
    <input type="submit" value="Score" class="btn btn-primary mt-2">
  </form>
<div>
